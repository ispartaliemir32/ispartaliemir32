# Publieke build-instellingen voor productie (GEEN geheimen: deze waarden staan
# na de build gewoon in de HTML). Next.js leest dit bestand bij `npm run build`,
# ook in Cloudflare Workers Builds, zodat je ze daar niet apart hoeft in te stellen.
# Geheimen (zoals TURNSTILE_SECRET_KEY) horen hier NOOIT; die staan in Cloudflare.

NEXT_PUBLIC_SITE_URL=https://kozbica.nl

# Turnstile SITE key (publiek). Wordt ingevuld zodra het Turnstile-widget is aangemaakt.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
