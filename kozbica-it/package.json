{
  "name": "kozbica-it-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website van Kozbica IT: statische Next.js-export, te hosten bij elke webhost.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "npm run build && npx wrangler dev --port 8787",
    "deploy": "npm run build && npx wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "brand": "node scripts/generate-brand-assets.mjs",
    "zip": "node scripts/make-upload-zip.mjs"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
