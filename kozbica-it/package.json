{
  "name": "kozbica-it-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website van Kozbica IT – Next.js static export op Cloudflare Workers Static Assets met een Worker voor het contactformulier.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "node scripts/ensure-out-dir.mjs && wrangler dev --port 8787",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
