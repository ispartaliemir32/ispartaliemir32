# ---------------------------------------------------------------------------
# Build-variabelen voor Next.js (worden tijdens `npm run build` in de
# statische HTML/JS opgenomen en zijn dus PUBLIEK; zet hier nooit geheimen).
#
# Lokaal: kopieer naar `.env.local` (dev) en/of `.env.production.local` (build).
# Cloudflare Workers Builds: stel ze in onder
#   Workers & Pages > kozbica-it > Settings > Build > Variables and secrets.
# ---------------------------------------------------------------------------

# Canonieke URL van de website, zonder slash aan het eind.
# Wordt gebruikt voor canonical-tags, Open Graph, sitemap.xml en robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.uwdomein.nl

# Cloudflare Turnstile SITE key (publiek). Aanmaken via Cloudflare dashboard > Turnstile.
# Voor lokaal testen kunt u de officiële testsleutel gebruiken: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Alleen voor `npm run dev`: waar draait `wrangler dev`? (standaard http://127.0.0.1:8787)
# WORKER_DEV_URL=http://127.0.0.1:8787
