# ---------------------------------------------------------------------------
# Lokale Worker-variabelen voor `wrangler dev` (kopieer naar `.dev.vars`).
# Deze waarden overschrijven "vars" uit wrangler.jsonc, ALLEEN lokaal.
# In productie stelt u geheimen in met `npx wrangler secret put <NAAM>`.
# ---------------------------------------------------------------------------

# Turnstile TEST-secret (accepteert alleen het testtoken van site key 1x00000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Lokaal simuleert `wrangler dev` de send_email-binding: e-mails worden gelogd, niet verzonden.
EMAIL_PROVIDER=cloudflare
CONTACT_TO_EMAIL=ontvanger@example.com
CONTACT_FROM_EMAIL=website@example.com
CONTACT_FROM_NAME="Kozbica IT website (lokaal)"

# Alleen bij EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Alleen bij EMAIL_PROVIDER=msgraph
# MSGRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# MSGRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MSGRAPH_CLIENT_SECRET=xxxxxxxx
