/**
 * Optioneel: alleen nodig als je de site op Cloudflare zet (Workers Static
 * Assets). Voor gewone webhosting (bijv. STRATO) heb je dit bestand niet nodig:
 * upload dan de inhoud van de map `out/`. Zie README.md.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kozbica-it",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
